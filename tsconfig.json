{
  // Single combined program for host + client + preview sources. SDK types
  // resolve from the @deepseek-ai/* npm packages in devDependencies, never
  // from a source checkout. Declaration emit feeds the package exports map
  // (lib/types/index.d.ts, lib/types/client/index.d.ts); JS emit is tsdown's job.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "./lib/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
